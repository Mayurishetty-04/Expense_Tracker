###############################
# Node Modules (frontend + backend)
###############################
node_modules/
frontend/node_modules/
backend/node_modules/

###############################
# Environment Files (very important!)
###############################
.env
.env.local
.env.*.local

# Ignore env inside frontend and backend
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

###############################
# Build / Dist Outputs
###############################
# Vite or CRA build output
frontend/build/
frontend/dist/

# If backend ever has build output
backend/build/
backend/dist/

###############################
# Logs
###############################
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

###############################
# OS & Editor Files
###############################
.DS_Store
Thumbs.db

# IDE config
.vscode/
.idea/

###############################
# Prisma / SQLite / DB Files
###############################
*.db
*.sqlite
prisma/*.db
prisma/migrations/

###############################
# Temporary Files
###############################
*.temp
*.tmp
*.cache
